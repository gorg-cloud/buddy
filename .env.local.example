# Buddy — Supabase connection
# Buddy has NO demo mode: until these keys are set, the site shows honest
# empty states instead of fake data. Setting them makes real accounts,
# matching, the arrival board, and the map all come alive.
#
# 1. Create a free project at https://supabase.com
# 2. Open SQL Editor → New query → paste supabase/schema.sql → Run
# 3. Project Settings → API → copy the three values below
# 4. Rename this file to `.env.local`, fill it in, restart `npm run dev`

# Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon public key (safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — SECRET. Server only, never in the browser.
# Used by the matching engine and the public map/board to read
# RLS-private profile data with a strict column whitelist.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
