# Copy this file to .env.local and fill in your Supabase project keys.
# Get them from: Supabase dashboard → Project Settings → API
#
# Until these are set, the site runs in DEMO MODE with sample data —
# every page works, but accounts aren't real.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
