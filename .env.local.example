# Copy this file to .env.local and fill in your Supabase project keys.
# Get them from: Supabase dashboard → Project Settings → API
#
# Until these are set, the site runs in DEMO MODE with sample data —
# every page works, but accounts aren't real.

# Public keys — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server only. Never expose this to the browser. It's used
# by the matching engine to read buddy profiles (bypasses row-level
# security). Find it in Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
